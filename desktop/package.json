{
  "name": "scopes-tool-desktop",
  "version": "0.1.0",
  "private": true,
  "productName": "Scopes Tool",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs",
    "dist:win": "electron-builder --dir --win --x64"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "directories": {
      "output": "../dist/desktop"
    },
    "files": [
      "main.cjs",
      "assets/scopes-icon.ico"
    ],
    "win": {
      "icon": "assets/scopes-icon.ico"
    }
  }
}
